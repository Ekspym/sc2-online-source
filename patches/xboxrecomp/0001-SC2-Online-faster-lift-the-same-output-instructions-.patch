From: Ekspym <110356286+Ekspym@users.noreply.github.com>
Date: Tue, 24 Nov 2026 21:37:55 +0100
Subject: [PATCH] SC2 Online: faster lift, the same output: instructions
 decoded in small batches / one at a time and kept by their bytes
 (disassemble_cfg, the disasm prefix checks), each function's decoded stream
 kept for the translator (disassemble_function). Player's build 629-703 s ->
 212 s, exe byte-identical

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tools/disasm/engine.py |  7 ++---
 tools/recomp/disasm.py | 61 +++++++++++++++++++++++++++++++++++++-----
 2 files changed, 59 insertions(+), 9 deletions(-)

diff --git a/tools/disasm/engine.py b/tools/disasm/engine.py
index 06202cb..b6c7521 100644
--- a/tools/disasm/engine.py
+++ b/tools/disasm/engine.py
@@ -21,6 +21,7 @@ from capstone.x86_const import (
 
 from . import config
 from .loader import BinaryImage, SectionInfo
+from ..recomp.disasm import cs_stream
 
 
 @dataclass
@@ -352,7 +353,7 @@ class DisasmEngine:
 
         added = 0
         overlaps = set()
-        for cs_insn in self._cs.disasm(data[offset:], addr):
+        for cs_insn in cs_stream(self._cs, data, offset, len(data), addr):
             if cs_insn.address != addr and cs_insn.address in self.instructions:
                 break  # resynced with the existing stream
             if replace_overlaps:
@@ -518,7 +519,7 @@ class DisasmEngine:
             flag_tests = (X86_EFLAGS_TEST_AF | X86_EFLAGS_TEST_CF
                           | X86_EFLAGS_TEST_OF | X86_EFLAGS_TEST_PF
                           | X86_EFLAGS_TEST_SF | X86_EFLAGS_TEST_ZF)
-            for insn in self._cs.disasm(raw[addr - lower:], addr):
+            for insn in cs_stream(self._cs, raw, addr - lower, len(raw), addr):
                 if (X86_REG_EFLAGS in insn.regs_read
                         and (insn.eflags & flag_tests or not insn.eflags)):
                     return False
@@ -837,7 +838,7 @@ class DisasmEngine:
                 offset = addr - section.virtual_addr
                 if offset < 0 or offset >= len(data):
                     return False
-                decoded = next(self._cs.disasm(data[offset:], addr, count=1),
+                decoded = next(self._cs.disasm(data[offset:offset + 15], addr, count=1),
                                None)
                 if decoded is None:
                     return False  # undecodable: not code
diff --git a/tools/recomp/disasm.py b/tools/recomp/disasm.py
index cc9644d..4eaf63f 100644
--- a/tools/recomp/disasm.py
+++ b/tools/recomp/disasm.py
@@ -5,7 +5,7 @@ Disassembles raw bytes from the XBE and organizes instructions
 into basic blocks within each function.
 """
 
-from dataclasses import dataclass, field
+from dataclasses import dataclass, field, replace
 from typing import Optional
 from capstone import Cs, CS_ARCH_X86, CS_MODE_32, CS_OP_IMM, CS_OP_MEM
 
@@ -147,6 +147,25 @@ def _parse_operand(cs, cs_op, insn_obj):
         return Operand(type="reg", reg=_reg_names.get(cs_op.reg, f"r{cs_op.reg}"))
 
 
+_DECODED = {}  # (address, bytes) -> Instruction: Disassembler._decode_at
+
+
+def cs_stream(cs, raw_bytes, offset, size, address, batch=32):
+    """The instructions from offset on, as cs.disasm(raw_bytes[offset:size], address) gives them, decoded a batch at
+    a time: cs_disasm decodes (with detail) everything it is handed before it returns the first one, and the callers
+    stop after a few instructions. A window of batch * 15 bytes: an instruction cut by its end is decoded whole by the
+    next window; an undecodable instruction ends the stream, as it ended the single call."""
+    while offset < size:
+        got = 0
+        for cs_insn in cs.disasm(raw_bytes[offset:min(size, offset + batch * 15)], address, count=batch):
+            got += 1
+            offset += cs_insn.size
+            address += cs_insn.size
+            yield cs_insn
+        if not got:
+            return
+
+
 class Disassembler:
     """Capstone-based x86-32 disassembler."""
 
@@ -154,6 +173,8 @@ class Disassembler:
         self._cs = Cs(CS_ARCH_X86, CS_MODE_32)
         self._cs.detail = True
         _init_reg_names(self._cs)
+        # (SC2 Online: the translator decodes each function four times or so; its decoded stream is kept)
+        self._function_cache = {}
 
     def _decode_instruction(self, cs_insn):
         """Convert one Capstone instruction into the translator model."""
@@ -220,7 +241,14 @@ class Disassembler:
         size = end_va - start_va
         if size <= 0 or size > len(raw_bytes):
             return []
+        key = (start_va, end_va, tuple(sorted(resync or ())), bytes(raw_bytes[:size]))
+        kept = self._function_cache.get(key)
+        if kept is None:
+            kept = self._function_cache[key] = self._disassemble_function(raw_bytes, start_va, end_va, resync)
+        return list(kept)
 
+    def _disassemble_function(self, raw_bytes, start_va, end_va, resync=None):
+        size = end_va - start_va
         decoded = {}
         for cs_insn in self._cs.disasm(raw_bytes[:size], start_va):
             decoded[cs_insn.address] = self._decode_instruction(cs_insn)
@@ -239,6 +267,24 @@ class Disassembler:
 
         return [decoded[a] for a in sorted(decoded)]
 
+    def _decode_at(self, raw_bytes, offset, size, address):
+        """The one instruction at offset (as the stream from there would decode it: whole, before size), or None. The
+        probes of the function detector decode the same code thousands of times: a decoded instruction is kept by its
+        address and bytes (an x86 instruction decodes from those alone) and handed out as a copy."""
+        if offset >= size:
+            return None
+        window = bytes(raw_bytes[offset:min(size, offset + 15)])
+        key = (address, window)
+        insn = _DECODED.get(key)
+        if insn is None:
+            cs_insn = next(self._cs.disasm(window, address, count=1), None)
+            if cs_insn is None:
+                return None
+            insn = self._decode_instruction(cs_insn)
+            _DECODED[key] = insn
+        return replace(insn, operands=list(insn.operands), memory_refs=list(insn.memory_refs),
+                       imm_values=list(insn.imm_values), regs_written=list(insn.regs_written))
+
     def disassemble_cfg(self, raw_bytes, start_va, end_va, entry_points,
                         stop_addresses=None, stop_mnemonics=()):
         """Decode reachable instruction streams from an explicit worklist."""
@@ -253,14 +299,17 @@ class Disassembler:
             entry = worklist.pop()
             if not (start_va <= entry < end_va) or entry in decoded:
                 continue
-            offset = entry - start_va
-            for cs_insn in self._cs.disasm(raw_bytes[offset:size], entry):
-                if cs_insn.address != entry and cs_insn.address in stop_addresses:
+            address = entry
+            while True:
+                insn = self._decode_at(raw_bytes, address - start_va, size, address)
+                if insn is None:
+                    break
+                if insn.address != entry and insn.address in stop_addresses:
                     break
-                if cs_insn.address >= end_va or cs_insn.address in decoded:
+                if insn.address >= end_va or insn.address in decoded:
                     break
-                insn = self._decode_instruction(cs_insn)
                 decoded[insn.address] = insn
+                address += insn.size
 
                 if (insn.is_cond_jump and insn.jump_target is not None
                         and start_va <= insn.jump_target < end_va):
